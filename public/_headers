# Cloudflare Pages: caching. Same as the headers in vercel.json.

# Hashed build files never change, so they are kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images regenerated now and then: kept a day, refreshed in the background.
/scene-desktop.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/scene-mobile.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-image.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
